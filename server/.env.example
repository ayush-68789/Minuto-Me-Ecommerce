# Owner: Member 1 — backend configuration.
PORT=5000
CLIENT_URL=http://localhost:5173
REDIS_URL=redis://127.0.0.1:6379
# Set this only to the number of reverse-proxy hops you control; keep 0 for direct access.
TRUST_PROXY_HOPS=0

# Seeds the only admin account at startup. Use your own values; never commit a real .env.
ADMIN_EMAIL=admin@minuto.test
ADMIN_PASSWORD=change-me-before-demo

# Required to accept payment webhook events; use a random secret in local/demo configuration.
PAYMENT_WEBHOOK_SECRET=replace-with-a-random-local-secret
