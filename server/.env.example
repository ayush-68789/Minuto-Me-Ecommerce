# Local application
PORT=5000
CLIENT_URL=http://localhost:5173
TRUST_PROXY_HOPS=0

# Redis-backed rate limiting
REDIS_URL=redis://127.0.0.1:6379

# MongoDB replica set is required for inventory transactions.
MONGODB_URI=mongodb://127.0.0.1:27017/commerceforge?replicaSet=rs0
RESERVATION_TTL_MINUTES=10
SWEEPER_ENABLED=true
SWEEPER_CRON=* * * * *
INVENTORY_ENABLED=true
ADMIN_REPORTS_ENABLED=true
ATTACK_DEMO_ENABLED=true

# Seeds the local admin account. Change these before using admin routes.
ADMIN_EMAIL=admin@minuto.test
ADMIN_PASSWORD=change-me-before-demo
