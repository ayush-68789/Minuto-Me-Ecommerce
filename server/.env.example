# Local application
PORT=5000
CLIENT_URL=http://localhost:5173
TRUST_PROXY_HOPS=0

# Redis-backed token bucket rate limiting
REDIS_URL=redis://127.0.0.1:6379

# MongoDB replica set is required for inventory transactions.
MONGODB_URI=mongodb://127.0.0.1:27017/commerceforge?replicaSet=rs0
INVENTORY_ENABLED=true
RESERVATION_TTL_MINUTES=10
RESERVATION_LIFECYCLE_ENABLED=true
ADMIN_REPORTS_ENABLED=true
CHECKOUT_ENABLED=true
ATTACK_DEMO_ENABLED=true

# Razorpay uses mock mode when no API key is configured.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=change-this-local-webhook-secret
PAYMENT_WEBHOOK_SECRET=replace-with-a-random-local-secret

# Seeds the local admin account. Change these before using admin routes.
ADMIN_EMAIL=admin@minuto.test
ADMIN_PASSWORD=change-me-before-demo
